# Giphy API key (get one at https://developers.giphy.com/)
# GIPHY_API_KEY=your_giphy_api_key_here

# Optional overrides (defaults shown)
# PORT=3001
# HOST=127.0.0.1
# DEV_ORIGIN=http://localhost:3000
# PRO_ORIGIN=https://AuxSync.com

# Dev only: auto-restart the server when a backend file changes (in-memory
# rooms are wiped on each restart). Leave unset/0 in production.
# DEV_RELOAD=1
