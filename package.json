{
  "name": "auxsync",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd python-auxsync && .venv\\Scripts\\python.exe src\\main.py",
    "dev:web": "npm --prefix react-auxsync run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
